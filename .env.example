# TAD Drivers build configuration. Copy to `.env` (git-ignored) and fill in. NEVER commit real values.

# --- App identity -------------------------------------------------------------------------------------------
APP_NAME=TAD Drivers
# Android applicationId. Once published to Google Play it can never change.
APP_IDENTIFIER=uk.co.texasafterdark.drivers
APP_LINK_PREFIX=tadrivers

# --- TAD delivery platform (the shop's backend: clock in/out, bag scan, delivered/failed, notifications) ------
# Default platform address, e.g. https://drivers.example.com . Drivers can change it in Account > TAD platform.
# The per-driver token is NOT a build setting: the shop admin issues it (POST /api/drivers/:id/token) and the driver
# pastes it into the app. It is stored in the Android Keystore, never in this file.
TAD_PLATFORM_URL=

# --- Fleetbase (navigation, order screens, proof of delivery) -----------------------------------------------
FLEETBASE_HOST=
FLEETBASE_KEY=
# Only if your Fleetbase uses its own SocketCluster host (defaults to socket.fleetbase.io otherwise)
SOCKETCLUSTER_HOST=
SOCKETCLUSTER_PORT=
SOCKETCLUSTER_SECURE=

# --- Maps ---------------------------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
# Shown on the map before the first GPS fix: lat,lng of the shop
DEFAULT_COORDINATES=

# --- Background location (Transistorsoft react-native-background-geolocation) --------------------------------
# Release builds need a licence key bound to APP_IDENTIFIER (debug builds work without one).
TRANSISTORSOFT_LICENSE_KEY=

# --- Release signing (Android). See docs/BUILD_ANDROID.md --------------------------------------------------
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
ANDROID_NAVIGATOR_APP_UPLOAD_STORE_FILE=
ANDROID_NAVIGATOR_APP_UPLOAD_STORE_PASSWORD=
ANDROID_NAVIGATOR_APP_UPLOAD_KEY_ALIAS=
ANDROID_NAVIGATOR_APP_UPLOAD_KEY_PASSWORD=
